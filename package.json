{
  "name": "zooly-api",
  "version": "1.0.0",
  "description": "API do Zooly Game com Node.js, Express e MongoDB",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:demo": "nodemon --exec \"node --env-file=.env.demo\" src/server.js",
    "start": "node src/server.js",
    "start:demo": "node --env-file=.env.demo src/server.js",
    "demo:verificar": "node --env-file=.env.demo scripts/demoDados.js",
    "demo:semear": "node --env-file=.env.demo scripts/demoDados.js --executar",
    "demo:limpar": "node --env-file=.env.demo scripts/demoDados.js --limpar --executar",
    "test": "node --test \"test/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZoolyEdu/Zooly-api.git"
  },
  "keywords": [
    "zooly",
    "api",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
